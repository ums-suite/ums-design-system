{
  "name": "ums-design-system-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development workspace for @ums/design-system — the shared Angular 22 UI kit and design-token package for the UMS platform.",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "projects/design-system"
  ],
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run tokens:build && npm run icons:build",
    "prepare": "husky",
    "tokens:build": "node tools/tokens/build-tokens.mjs",
    "icons:build": "node tools/icons/build-icons.mjs",
    "prestart": "npm run build:lib",
    "start": "ng serve catalog",
    "build": "ng build design-system && ng build catalog",
    "build:lib": "ng build design-system",
    "watch": "ng build design-system --watch --configuration development",
    "test": "ng test design-system --runner=karma",
    "test:watch": "ng test design-system --runner=karma --watch=true",
    "test:catalog": "ng test catalog --runner=karma",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.scss\"",
    "stylelint:fix": "stylelint \"**/*.scss\" --fix",
    "pree2e": "npm run build:lib",
    "e2e": "playwright test",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix --max-warnings 0 --no-warn-ignored",
    "*.scss": "stylelint --fix",
    "*.{ts,html,scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.55.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.10.0",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lint-staged": "^17.4.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "style-dictionary": "^5.5.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0"
  }
}
